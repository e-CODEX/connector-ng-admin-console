{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": false,
    "semi": true,
    "overrides": [
        {
            "files": ["*.ts"],
            "options": {
                "printWidth": 120
            }
        },
        {
            "files": ["*.tsx"],
            "options": {
                "printWidth": 180
            }
        }
    ]
}
